# Neon runtime connection (use the pooled connection string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Neon migrations (use the direct, non-pooler connection string).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# JWT Authentication (HS256 secret)
JWT_SECRET="your-32-character-or-longer-secret-key-for-jwt-signing"

# Vehicle photo storage.
# Cloudinary (recommended for general hosting / Docker / Coolify / auto-optimization):
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# Or individually:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
#
# Or Vercel Private Blob:
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace_me"
#
# (If neither is configured, photos are saved locally in public/uploads during development)

# Application configuration.
APP_TIMEZONE="Asia/Dubai"
NEXT_PUBLIC_APP_NAME="Car Scrap Business"

# Optional monitoring.
SENTRY_DSN=""
