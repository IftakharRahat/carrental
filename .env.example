# Neon runtime connection (use the pooled connection string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Neon migrations (use the direct, non-pooler connection string).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Clerk authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Vercel Private Blob.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace_me"

# Application configuration.
APP_TIMEZONE="Asia/Dubai"
NEXT_PUBLIC_APP_NAME="Car Scrap Business"

# Optional monitoring.
SENTRY_DSN=""
